"""This repo's own dev/test //st:toolchain_type toolchain.

Dogfoods README.md's Option A recipe: wraps the plc release built by
//plc_compiler (see plc_compiler/release.sh). Wired into tests/ via
--extra_toolchains in .bazelrc, not register_toolchains() (see MODULE.bazel).
"""

load("//st:toolchain.bzl", "st_toolchain")

package(default_visibility = ["//visibility:public"])

st_toolchain(
    name = "plc_compiler",
    compiler = "@plc_linux_x86_64//:plc",
    compiler_runtime_files = ["@plc_linux_x86_64//:runtime_libs"],
    # Only resolvable when rules_plc is root, true here -- see MODULE.bazel's
    # dev_dependency toolchains_llvm usage.
    linker = "@llvm_toolchain_llvm//:bin/clang",
)

toolchain(
    name = "plc",
    toolchain = ":plc_compiler",
    toolchain_type = "//st:toolchain_type",
)
