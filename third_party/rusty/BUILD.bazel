load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("//st:toolchain.bzl", "st_toolchain")

package(default_visibility = ["//visibility:public"])

# rusty's plc_llvm crate depends on the llvm-sys/inkwell crates, whose upstream
# build.rs shells out to `llvm-config` and searches system paths for LLVM. That
# doesn't work under Bazel's sandbox, so this build.rs (adapted from densha) is
# swapped in via crate.annotation(override_target_build_script=...) in
# MODULE.bazel, pointed at the toolchains_llvm-provided LLVM instead.
genrule(
    name = "llvm_prefix",
    srcs = [
        "@llvm_toolchain_llvm//:bin/llvm-config",
        "@llvm_toolchain_llvm//:lib/libclang.so",
    ],
    outs = ["llvm_prefix.txt"],
    cmd = """
LLVM_CONFIG="$(execpath @llvm_toolchain_llvm//:bin/llvm-config)"
LLVM_LIBS="$(execpath @llvm_toolchain_llvm//:lib/libclang.so)"
LLVM_BIN_DIR="$$(dirname "$$LLVM_CONFIG")"
LLVM_SYS_211_PREFIX="$${LLVM_BIN_DIR%/bin}"
LLVM_SYS_SYSTEM_LIBRARY_DIRS="$$(dirname "$$LLVM_LIBS")"
echo "LLVM_SYS_211_PREFIX=$$LLVM_SYS_211_PREFIX" > $@
""",
)

copy_file(
    name = "target_c",
    src = "@@rules_rust++crate+rusty_crates__llvm-sys-211.0.1//:wrappers/target.c",
    out = "wrappers/target.c",
    is_executable = False,
    allow_symlink = False,
)

cargo_build_script(
    name = "llvm_sys_build_script",
    srcs = ["build.rs"],
    pkg_name = "llvm-sys",
    version = "211.0.1",
    edition = "2021",
    deps = [
        "@rusty_crates//:anyhow",
        "@rusty_crates//:cc",
        "@rusty_crates//:lazy_static",
        "@rusty_crates//:regex",
        "@rusty_crates//:semver",
    ],
    data = [
        "@llvm_toolchain_llvm//:bin/llvm-config",
        ":target_c",
    ],
    build_script_env_files = [":llvm_prefix.txt"],
    rustc_flags = ["--verbose"],
)

# rustc passes -l<name> requiring libraries to be in the linker paths.
# Bazel's bazel_dep archives don't expose .so files under
# those canonical names, so extract/build them here for the final `plc` link.
genrule(
    name = "libffi_so_src",
    srcs = ["@libffi//:libffi"],
    outs = ["libffi.so"],
    cmd = """
set -eu
for f in $(locations @libffi//:libffi); do
  case "$$f" in
    *.so) cp "$$f" "$@"; exit 0 ;;
  esac
done
echo "libffi shared object not found in @libffi//:libffi outputs" >&2
exit 1
""",
)

genrule(
    name = "libxml2_so_src",
    srcs = ["@libxml2"],
    outs = ["libxml2.so"],
    cmd = """
set -eu
for f in $(locations @libxml2); do
  case "$$f" in
    *.so) cp "$$f" "$@"; exit 0 ;;
  esac
done
echo "libxml2 shared object not found in @libxml2 outputs" >&2
exit 1
""",
)

genrule(
    name = "libz_so_src",
    srcs = ["@zlib//:zlib"],
    outs = ["libz.so"],
    cmd = """
set -eu
for f in $(locations @zlib//:zlib); do
  case "$$f" in
    */libz.so|*.so) cp "$$f" "$@"; exit 0 ;;
  esac
done
echo "libz shared object not found in @zlib//:zlib outputs" >&2
exit 1
""",
)

genrule(
    name = "libzstd_so_src",
    srcs = ["@zstd//:zstd"],
    outs = ["libzstd.so"],
    cmd = """
set -eu
archive=""
for f in $(locations @zstd//:zstd); do
  case "$$f" in
    *.pic.a) archive="$$f"; break ;;
  esac
done
if [ -z "$$archive" ]; then
  for f in $(locations @zstd//:zstd); do
    case "$$f" in
      *.a) archive="$$f"; break ;;
    esac
  done
fi
if [ -z "$$archive" ]; then
  echo "no static archive found in @zstd//:zstd outputs" >&2
  exit 1
fi
/usr/bin/gcc -shared -Wl,--whole-archive "$$archive" -Wl,--no-whole-archive -pthread -lm -o "$@"
""",
)

cc_import(
    name = "ffi",
    shared_library = ":libffi.so",
)

cc_import(
    name = "xml2",
    shared_library = ":libxml2.so",
)

cc_import(
    name = "zlib",
    shared_library = ":libz.so",
)

cc_import(
    name = "zstd",
    shared_library = ":libzstd.so",
)

st_toolchain(
    name = "plc_compiler",
    compiler = "@rusty//:plc",
)

toolchain(
    name = "plc",
    toolchain = ":plc_compiler",
    toolchain_type = "//st:toolchain_type",
)


