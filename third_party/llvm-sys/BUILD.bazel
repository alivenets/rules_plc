load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")

package(default_visibility = ["//visibility:public"])

# rusty's plc_llvm crate depends on the llvm-sys/inkwell crates, whose upstream
# build.rs shells out to `llvm-config` and searches system paths for LLVM. That
# doesn't work under Bazel's sandbox, so this build.rs (adapted from densha) is
# swapped in via crate.annotation(override_target_build_script=...) in
# MODULE.bazel, pointed at the toolchains_llvm-provided LLVM instead.
genrule(
    name = "llvm_prefix",
    srcs = [
        "@llvm_toolchain_llvm//:bin/llvm-config",
        "@llvm_toolchain_llvm//:lib/libclang.so",
    ],
    outs = ["llvm_prefix.txt"],
    cmd = """
LLVM_CONFIG="$(execpath @llvm_toolchain_llvm//:bin/llvm-config)"
LLVM_LIBS="$(execpath @llvm_toolchain_llvm//:lib/libclang.so)"
LLVM_BIN_DIR="$$(dirname "$$LLVM_CONFIG")"
LLVM_SYS_211_PREFIX="$${LLVM_BIN_DIR%/bin}"
LLVM_SYS_SYSTEM_LIBRARY_DIRS="$$(dirname "$$LLVM_LIBS")"
echo "LLVM_SYS_211_PREFIX=$$LLVM_SYS_211_PREFIX" > $@
""",
)

# llvm-sys's own build.rs normally compiles wrappers/target.c itself (via the
# cc crate, driven by `llvm-config --cflags`) as part of running the build
# script. Compiling it as an ordinary cc_library instead means it goes
# through Bazel's own C++ toolchain machinery directly -- no need to
# replicate its default flags (e.g. the -imacros redacted_dates.h it always
# injects) by hand in build.rs. Linked into the llvm-sys crate via
# crate.annotation(link_deps = [...]) in MODULE.bazel.
#
# Referencing wrappers/target.c straight from the crate's own repo (rather
# than copying it into this package first) needs that repo's own name --
# "rusty_crates__<crate>-<version>" is crate_universe's documented naming
# convention for per-crate repos, made available locally via this module's
# own use_repo(crate, ...) instead of reaching for its (undocumented,
# Bazel-internal) canonical form.
cc_library(
    name = "targetwrappers",
    srcs = ["@rusty_crates__llvm-sys-211.0.1//:wrappers/target.c"],
    copts = [
        "-D_GNU_SOURCE",
        "-DEXPERIMENTAL_KEY_INSTRUCTIONS",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-D__STDC_LIMIT_MACROS",
    ],
    deps = ["@llvm_toolchain_llvm//:clang_headers"],
)

cargo_build_script(
    name = "llvm_sys_build_script",
    srcs = ["build.rs"],
    pkg_name = "llvm-sys",
    version = "211.0.1",
    edition = "2021",
    data = [
        "@llvm_toolchain_llvm//:lib_archives",
    ],
    build_script_env_files = [":llvm_prefix.txt"],
)
