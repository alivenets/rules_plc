load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//st:private/st_library.bzl", "st_library")
load("//st/private/tests/interface_deps:check.bzl", "check_interface_rule")

# Interface-only library
st_library(
    name = "iface",
    srcs = ["iface.st"],
    hdrs = [],
    visibility = ["//visibility:private"],
)

# A consumer that should NOT re-export iface's interfaces
st_library(
    name = "user",
    srcs = ["user.st"],
    interface_deps = [":iface"],
    visibility = ["//visibility:private"],
)

# Analysis-time check: will fail the build if `user` re-exports iface's interfaces
check_interface_rule(
    name = "check",
    target = ":user",
)

sh_test(
    name = "interface_deps_test",
    srcs = ["run.sh"],
    args = [],
    data = [":check"],
)
