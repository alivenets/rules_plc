load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_plc//st:defs.bzl", "st_binary", "st_library")
load("@rules_plc//st:toolchain.bzl", "st_toolchain")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":rules_test.bzl", "rules_test_suite")

# This module's own //st:toolchain_type toolchain, per README.md's Option A
# recipe -- dogfoods the release archive built by //plc_compiler (see
# ../plc_compiler/release.sh).
st_toolchain(
    name = "plc_compiler",
    compiler = "@plc_linux_x86_64//:plc",
    compiler_runtime_files = ["@plc_linux_x86_64//:runtime_libs"],
    linker = "@llvm_toolchain_llvm//:bin/clang",
)

toolchain(
    name = "plc",
    toolchain = ":plc_compiler",
    toolchain_type = "@rules_plc//st:toolchain_type",
)

# Regression coverage for the ST rules themselves (hdrs propagation, transitive
# deps), as opposed to examples/ which demonstrates typical usage.

# hdrs: a TYPE declared in a .dut header, with no implementation of its own,
# must be visible both to the owning library's own srcs and, re-exported, to
# its dependents. Also exercises st_library's generated C headers (exposed on
# its CcInfo), which the test #includes directly instead of hand-declaring
# extern "C" signatures.
st_library(
    name = "point_lib",
    srcs = [
        "point_lib.st",
        "point_types.dut",
    ],
)

cc_test(
    name = "hdrs_test",
    srcs = ["hdrs_test.cc"],
    deps = [
        ":point_lib",
        "@googletest//:gtest_main",
    ],
)

# Transitive deps: st_library A -> B -> C, with the binary only naming the
# top of the chain, must still link and expose symbols from every level.
st_library(
    name = "leaf",
    srcs = ["leaf.st"],
)

st_library(
    name = "middle",
    srcs = ["middle.st"],
    deps = [":leaf"],
)

st_library(
    name = "top",
    srcs = ["top.st"],
    deps = [":middle"],
)

cc_test(
    name = "transitive_deps_test",
    srcs = ["transitive_deps_test.cc"],
    deps = [
        ":top",
        "@googletest//:gtest_main",
    ],
)

# Façade st_library: no srcs of its own, just re-exports deps' StInfo/CcInfo
# under one name. Used by the corresponding analysis test in rules_test.bzl.
st_library(
    name = "leaf_middle_facade",
    deps = [
        ":leaf",
        ":middle",
    ],
)

# interface_deps: source-visible only. This façade's StInfo carries leaf's
# srcs (for cross-library type resolution at compile time) but does NOT
# carry leaf's compiled object, so a downstream link doesn't pull it in.
# Used by the corresponding analysis test in rules_test.bzl.
st_library(
    name = "leaf_interface_facade",
    interface_deps = [":leaf"],
)

# A concrete st_library with its own srcs plus a mix of deps and
# interface_deps -- exercises the semantics on a non-façade library.
st_library(
    name = "middle_with_interface_leaf",
    srcs = ["middle.st"],
    interface_deps = [":leaf"],
)

# Regression: a regular dep's interface_sources bucket must propagate
# through transitively, so a downstream packaging rule enumerating
# `sources` still filters out the vendor interfaces however deep in the
# graph they live. Chain: leaf --(interface_deps)--> middle_with_interface_leaf
# --(deps)--> top_over_interface_leaf.
st_library(
    name = "top_over_interface_leaf",
    srcs = ["top.st"],
    deps = [":middle_with_interface_leaf"],
)

# An st_binary that pulls leaf's sources through interface_deps only --
# the StLink action's argv must NOT include leaf_lib.o (the interface_dep
# is source-visible-only; its real impl would come from cc_deps). Uses
# no_program_main.st, which does not itself call into leaf, so the link
# stays satisfied even without leaf's object.
st_binary(
    name = "interface_dep_binary",
    srcs = ["no_program_main.st"],
    interface_deps = [":leaf"],
)

# A minimal st_binary purely to exercise st_binary's own StLink action/flags
# (see rules_test.bzl) -- unrelated to the st_library CcInfo-export coverage
# above, which now uses cc_test instead.
st_binary(
    name = "trivial_binary",
    program = "trivial_program.st",
)

# `program` is optional: with none given, srcs/hdrs are linked as-is with no
# generated wrapper, so one of them must supply its own FUNCTION main.
st_binary(
    name = "no_program_binary",
    srcs = ["no_program_main.st"],
)

sh_test(
    name = "no_program_binary_test",
    srcs = [":no_program_binary"],
)

# ANY/ANY_DUT: type-erased VAR_INPUT parameters (an untyped pointer, no
# runtime type tag), reinterpreted inside the FUNCTION as a known concrete
# type. See generics.st for the mechanics.
st_library(
    name = "generics",
    srcs = ["generics.st"],
)

cc_test(
    name = "generics_test",
    srcs = ["generics_test.cc"],
    deps = [
        ":generics",
        "@googletest//:gtest_main",
    ],
)

rules_test_suite(name = "rules_test")
