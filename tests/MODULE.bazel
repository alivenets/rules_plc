module(
    name = "rules_plc_tests",
    version = "0.1.0",
)

bazel_dep(name = "rules_plc", version = "0.1.0")
local_path_override(
    module_name = "rules_plc",
    path = "..",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.0.16")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "googletest", version = "1.15.2")

# googletest 1.15.2 transitively pulls re2@2024-07-02, whose MODULE.bazel
# uses the long-removed @bazel_tools//tools/cpp:cc_configure.bzl%
# cc_configure_extension -- fails to even load on Bazel 8.7+. Forcing MVS to
# a newer re2 (which moved that extension to @rules_cc) fixes it; we don't
# use re2 directly.
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")

bazel_dep(name = "rules_shell", version = "0.8.0")

# rules_plc's own toolchains_llvm usage is dev_dependency-only (see
# ../MODULE.bazel), so invisible here -- this module needs its own C++
# toolchain (cc_test) and clang (st_toolchain's linker below).
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "21.1.8",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "plc_linux_x86_64",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
exports_files(["plc"])
filegroup(name = "runtime_libs", srcs = glob(["*.so"]))
""",
    sha256 = "5388e2b4e2ed99f47ca271fb6b2265813b9e556f3b5c5ff0a86f87ab7a52942c",
    strip_prefix = "plc-linux-x86_64",
    url = "https://github.com/alivenets/rules_plc/releases/download/0.1.3/plc-linux-x86_64.tar.gz",
)

register_toolchains("//:plc")
