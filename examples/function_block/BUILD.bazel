load("//st:defs.bzl", "st_library")

# A FUNCTION_BLOCK (stateful, instantiable POU) compiled as an st_library,
# with a cc_test exercising an instance of it across multiple calls.
st_library(
    name = "counter",
    srcs = ["counter.st"],
)

cc_test(
    name = "counter_test",
    srcs = ["counter_test.cc"],
    deps = [
        ":counter",
        "@googletest//:gtest_main",
    ],
)
