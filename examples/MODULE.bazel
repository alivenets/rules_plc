module(
    name = "rules_plc_examples",
    version = "0.1.0",
)

bazel_dep(name = "rules_plc", version = "0.1.0")
local_path_override(
    module_name = "rules_plc",
    path = "..",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.0.16")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "googletest", version = "1.15.2")

# rules_plc exposes a module extension for the prebuilt plc release archive.
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "21.1.8",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

plc = use_extension("@rules_plc//st:plc_prebuilt_extensions.bzl", "plc")
plc.release(
    name = "plc_toolchain",
    label_injections = {
        "@llvm_toolchain_llvm": "@llvm_toolchain_llvm",
    },
    linker = "@llvm_toolchain_llvm//:bin/clang",
)
use_repo(plc, "plc_toolchain")

register_toolchains("@plc_toolchain//:plc_toolchain")
