load("//st:defs.bzl", "st_library")

# An st_library with a cc_test depending on it, exercising the compiled ST
# code directly through st_library's exported CcInfo.
st_library(
    name = "mathlib",
    srcs = ["mathlib.st"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "mathlib_test",
    srcs = ["mathlib_test.cc"],
    deps = [
        ":mathlib",
        "@googletest//:gtest_main",
    ],
)
