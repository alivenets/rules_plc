load("//st:defs.bzl", "st_library")

# fast_math.st declares fast_double as {external}: no ST implementation, just
# the signature. fast_math_c provides the real, native implementation, linked
# in via c_deps.
cc_library(
    name = "fast_math_c",
    srcs = ["fast_math.c"],
)

st_library(
    name = "fast_math",
    srcs = ["fast_math.st"],
    c_deps = [":fast_math_c"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "fast_math_test",
    srcs = ["fast_math_test.cc"],
    deps = [
        ":fast_math_c",
        "@googletest//:gtest_main",
    ],
)