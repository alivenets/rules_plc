load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

# rustc passes -l<name> requiring libraries to be in the linker paths.
# Bazel's bazel_dep archives don't expose .so files under
# those canonical names, so extract/build them here for the final `plc` link.
genrule(
    name = "libffi_so_src",
    srcs = ["@libffi//:libffi"],
    outs = ["libffi.so"],
    cmd = """
set -eu
for f in $(locations @libffi//:libffi); do
  case "$$f" in
    *.so) cp "$$f" "$@"; exit 0 ;;
  esac
done
echo "libffi shared object not found in @libffi//:libffi outputs" >&2
exit 1
""",
)

genrule(
    name = "libxml2_so_src",
    srcs = ["@libxml2"],
    outs = ["libxml2.so"],
    cmd = """
set -eu
for f in $(locations @libxml2); do
  case "$$f" in
    *.so) cp "$$f" "$@"; exit 0 ;;
  esac
done
echo "libxml2 shared object not found in @libxml2 outputs" >&2
exit 1
""",
)

genrule(
    name = "libz_so_src",
    srcs = ["@zlib//:zlib"],
    outs = ["libz.so"],
    cmd = """
set -eu
for f in $(locations @zlib//:zlib); do
  case "$$f" in
    */libz.so|*.so) cp "$$f" "$@"; exit 0 ;;
  esac
done
echo "libz shared object not found in @zlib//:zlib outputs" >&2
exit 1
""",
)

genrule(
    name = "libzstd_so_src",
    srcs = ["@zstd//:zstd"],
    outs = ["libzstd.so"],
    cmd = """
set -eu
archive=""
for f in $(locations @zstd//:zstd); do
  case "$$f" in
    *.pic.a) archive="$$f"; break ;;
  esac
done
if [ -z "$$archive" ]; then
  for f in $(locations @zstd//:zstd); do
    case "$$f" in
      *.a) archive="$$f"; break ;;
    esac
  done
fi
if [ -z "$$archive" ]; then
  echo "no static archive found in @zstd//:zstd outputs" >&2
  exit 1
fi
/usr/bin/gcc -shared -Wl,--whole-archive "$$archive" -Wl,--no-whole-archive -pthread -lm -o "$@"
""",
)

cc_import(
    name = "ffi",
    shared_library = ":libffi.so",
)

cc_import(
    name = "xml2",
    shared_library = ":libxml2.so",
)

cc_import(
    name = "zlib",
    shared_library = ":libz.so",
)

cc_import(
    name = "zstd",
    shared_library = ":libzstd.so",
)

# The plc_llvm C++ shim plc links against. Built here and injected into @rusty.
cc_library(
    name = "llvm_wrapper_objs",
    srcs = ["@rusty//:compiler/plc_llvm/src/cpp/llvm_wrapper.cpp"],
    copts = ["-fPIC"],
    linkopts = ["-Wl,--no-as-needed"],
    alwayslink = True,
    deps = ["@llvm_toolchain_llvm//:clang_headers"],
)

cc_binary(
    name = "libllvm_wrapper.so",
    linkshared = True,
    deps = [":llvm_wrapper_objs"],
)

cc_import(
    name = "llvm_wrapper",
    shared_library = ":libllvm_wrapper.so",
)

alias(
    name = "plc",
    actual = "@rusty//:plc",
)

# plc's runtime .so companions ($ORIGIN rpath, see rusty.BUILD.bazel) --
# release.sh bundles these alongside the binary so it runs standalone.
filegroup(
    name = "plc_runtime_libs",
    srcs = [
        ":libffi.so",
        ":libxml2.so",
        ":libz.so",
        ":libzstd.so",
        ":libllvm_wrapper.so",
    ],
)
