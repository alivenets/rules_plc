+#[test]
+fn external_file_function_block_with_hardware_address_member_is_not_redefined() {
+    // A FUNCTION_BLOCK with a hardware-addressed member is compiled into its own
+    // object by whatever module declares it (Internal linkage there), and also
+    // needs to be visible -- via `-i`/Include linkage -- to any other module that
+    // instantiates it. The backing global for the hardware address must be defined
+    // exactly once (by the Internal/declaring module) and only referenced as
+    // `external` everywhere else, or two separately-compiled objects that both
+    // instantiate the FUNCTION_BLOCK would each define the same symbol and fail to
+    // link.
+    let prog = SourceCode::new(
+        "
+    FUNCTION main : DINT
+    VAR
+        fb_instance : MyFb;
+    END_VAR
+        fb_instance();
+        main := 0;
+    END_FUNCTION
+    ",
+        "main.st",
+    );
+
+    let ext = SourceCode::new(
+        "
+    FUNCTION_BLOCK MyFb
+    VAR
+        Addr AT %QX0.0.1.0 : INT;
+    END_VAR
+    END_FUNCTION_BLOCK
+    ",
+        "external.st",
+    );
+
+    let results = compile_to_string(vec![prog], vec![ext], None, DebugLevel::None).unwrap();
+    filtered_assert_snapshot!(results.join("\n"));
+}
