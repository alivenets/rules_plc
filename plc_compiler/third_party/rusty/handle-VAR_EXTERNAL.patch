+fn contains_scalable_vector(ty: BasicTypeEnum<'_>) -> bool {
+    match ty {
+        BasicTypeEnum::ScalableVectorType(_) => true,
+        BasicTypeEnum::ArrayType(array) => contains_scalable_vector(array.get_element_type()),
+        BasicTypeEnum::StructType(strct) => {
+            strct.get_field_types().into_iter().any(contains_scalable_vector)
+        }
+        _ => false,
+    }
