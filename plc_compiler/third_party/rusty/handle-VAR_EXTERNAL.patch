+#[test]
+fn external_file_global_function_block_var_referenced_via_var_external() {
+    let prog = SourceCode::new(
+        "
+    FUNCTION main : DINT
+    VAR_EXTERNAL
+        fb_instance : MyFb;
+    END_VAR
+        fb_instance();
+        main := 0;
+    END_FUNCTION
+    ",
+        "main.st",
+    );
+
+    let ext = SourceCode::new(
+        "
+    FUNCTION_BLOCK MyFb
+    END_FUNCTION_BLOCK
+
+    VAR_GLOBAL
+        fb_instance : MyFb;
+    END_VAR
+    ",
+        "external.st",
+    );
+
+    let results = compile_to_string(vec![prog], vec![ext], None, DebugLevel::None).unwrap();
+    filtered_assert_snapshot!(results.join("\n"));
+}
