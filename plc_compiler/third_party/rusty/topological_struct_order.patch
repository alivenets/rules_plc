+
+    /// Reorders `template_data.user_defined_types.structs` so that every
+    /// struct's value-typed field dependencies (fields whose `data_type`
+    /// is another emitted struct's name and is *not* a pointer) appear
+    /// in the list before it does. Pointer fields need only a forward
+    /// declaration and don't participate in the ordering.
+    ///
+    /// ST source order is unstable for this purpose: a FUNCTION_BLOCK
+    /// referenced by another as a `VAR_OUTPUT` field (value semantics)
+    /// may be declared *below* its user in the ST source, producing a C
+    /// header where a struct member has "incomplete type" -- a hard
+    /// compile error. This pass runs right before rendering (so both the
+    /// single-unit and combined-headers paths hit it) and reorders the
+    /// structs topologically.
+    fn resolve_struct_dependency_order(&mut self) {
+        let n = self.template_data.user_defined_types.structs.len();
+        if n < 2 {
+            return;
+        }
+
+        let reference_symbol = self.get_reference_symbol();
+
+        // IEC 61131-3 identifiers are case-insensitive, but rusty's
+        // header pipeline preserves source case for field type names
+        // while normalizing POU/struct declaration names to their POU's
+        // canonical case. Compare case-insensitively here so a field
+        // like `tStatusInfo: SDIT3xx_STATUSINFO` still resolves to the
+        // FB's `SDIT3XX_STATUSINFO_type` struct entry.
+        let mut name_to_index: HashMap<String, usize> = HashMap::with_capacity(n);
+        for (i, s) in self.template_data.user_defined_types.structs.iter().enumerate() {
+            name_to_index.insert(s.name.to_ascii_lowercase(), i);
+        }
+
+        let mut dependencies: Vec<Vec<usize>> = vec![Vec::new(); n];
+        for (i, s) in self.template_data.user_defined_types.structs.iter().enumerate() {
+            let mut seen: std::collections::HashSet<usize> = std::collections::HashSet::new();
+            for variable in &s.variables {
+                // Pointer (reference) fields need only the forward
+                // declaration already emitted for every POU struct, so
+                // they impose no ordering constraint here.
+                if variable.data_type.ends_with(reference_symbol.as_str()) {
+                    continue;
+                }
+                let key = variable.data_type.to_ascii_lowercase();
+                if let Some(&j) = name_to_index.get(key.as_str()) {
+                    if i != j && seen.insert(j) {
+                        dependencies[i].push(j);
+                    }
+                }
+            }
+        }
+
+        // Kahn-style topological sort, breaking ties by original index
+        // to keep the emission order deterministic and close to the ST
+        // source order.
+        let mut emitted = vec![false; n];
+        let mut order: Vec<usize> = Vec::with_capacity(n);
+        loop {
+            let mut progress = false;
+            for i in 0..n {
+                if emitted[i] {
+                    continue;
+                }
+                if dependencies[i].iter().all(|&j| emitted[j]) {
+                    order.push(i);
+                    emitted[i] = true;
+                    progress = true;
+                }
+            }
+            if !progress {
+                break;
+            }
+        }
+
+        // Any structs left in a cycle (only possible via pointer refs,
+        // which this pass ignores -- so, in practice, unreachable) are
+        // appended in original order to guarantee this pass never drops
+        // a struct.
+        for i in 0..n {
+            if !emitted[i] {
+                order.push(i);
+            }
+        }
+
+        let sorted: Vec<UserType> = order
+            .into_iter()
+            .map(|i| self.template_data.user_defined_types.structs[i].clone())
+            .collect();
+        self.template_data.user_defined_types.structs = sorted;
+    }
