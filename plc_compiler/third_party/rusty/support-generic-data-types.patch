+#[test]
+fn any_data_types_are_void_pointers() {
+    let index = get_index();
+
+    let any = index.get_type_or_panic(ANY_TYPE);
+    let any_num = index.get_type_or_panic(ANY_NUM_TYPE);
+    let any_real = index.get_type_or_panic(ANY_REAL_TYPE);
+    let any_simple = index.get_type_or_panic(ANY_SIMPLE_TYPE);
+    let any_bit = index.get_type_or_panic(ANY_BIT_TYPE);
+    let any_dut = index.get_type_or_panic(ANY_DUT_TYPE);
+
+    assert!(matches!(
+        any.get_type_information(),
+        typesystem::DataTypeInformation::Pointer { inner_type_name, .. } if inner_type_name == VOID_INTERNAL_NAME
+    ));
+    assert!(matches!(
+        any_num.get_type_information(),
+        typesystem::DataTypeInformation::Pointer { inner_type_name, .. } if inner_type_name == VOID_INTERNAL_NAME
+    ));
+    assert!(matches!(
+        any_real.get_type_information(),
+        typesystem::DataTypeInformation::Pointer { inner_type_name, .. } if inner_type_name == VOID_INTERNAL_NAME
+    ));
+    assert!(matches!(
+        any_simple.get_type_information(),
+        typesystem::DataTypeInformation::Pointer { inner_type_name, .. } if inner_type_name == VOID_INTERNAL_NAME
+    ));
+    assert!(matches!(
+        any_bit.get_type_information(),
+        typesystem::DataTypeInformation::Pointer { inner_type_name, .. } if inner_type_name == VOID_INTERNAL_NAME
+    ));
+    assert!(matches!(
+        any_dut.get_type_information(),
+        typesystem::DataTypeInformation::Pointer { inner_type_name, .. } if inner_type_name == VOID_INTERNAL_NAME
+    ));
+
+    assert!(any.has_nature(TypeNature::Any, &index));
+    assert!(any_num.has_nature(TypeNature::Num, &index));
+    assert!(any_real.has_nature(TypeNature::Real, &index));
+    assert!(any_simple.has_nature(TypeNature::Elementary, &index));
+    assert!(any_bit.has_nature(TypeNature::Bit, &index));
+    assert!(any_dut.has_nature(TypeNature::Derived, &index));
+}
