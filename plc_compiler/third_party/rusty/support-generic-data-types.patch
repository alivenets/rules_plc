+#[test]
+fn any_datatypes_can_be_used_in_variable_declarations() {
+    let source = r#"
+        FUNCTION foo : DINT
+        VAR_INPUT
+            a : ANY;
+            d : ANY_NUM;
+            e : ANY_REAL;
+            f : ANY_SIMPLE;
+            b : ANY_BIT;
+            c : ANY_DUT;
+        END_VAR
+        END_FUNCTION
+    "#;
+
+    let (_, index) = index(source);
+
+    let a = index.find_member("foo", "a").unwrap();
+    let d = index.find_member("foo", "d").unwrap();
+    let e = index.find_member("foo", "e").unwrap();
+    let f = index.find_member("foo", "f").unwrap();
+    let b = index.find_member("foo", "b").unwrap();
+    let c = index.find_member("foo", "c").unwrap();
+
+    assert_eq!(a.get_type_name(), "ANY");
+    assert_eq!(d.get_type_name(), "ANY_NUM");
+    assert_eq!(e.get_type_name(), "ANY_REAL");
+    assert_eq!(f.get_type_name(), "ANY_SIMPLE");
+    assert_eq!(b.get_type_name(), "ANY_BIT");
+    assert_eq!(c.get_type_name(), "ANY_DUT");
+
+    assert!(matches!(
+        index.find_effective_type_info("ANY"),
+        Some(DataTypeInformation::Pointer { inner_type_name, .. }) if inner_type_name == "__VOID"
+    ));
+    assert!(matches!(
+        index.find_effective_type_info("ANY_NUM"),
+        Some(DataTypeInformation::Pointer { inner_type_name, .. }) if inner_type_name == "__VOID"
+    ));
+    assert!(matches!(
+        index.find_effective_type_info("ANY_REAL"),
+        Some(DataTypeInformation::Pointer { inner_type_name, .. }) if inner_type_name == "__VOID"
+    ));
+    assert!(matches!(
+        index.find_effective_type_info("ANY_SIMPLE"),
+        Some(DataTypeInformation::Pointer { inner_type_name, .. }) if inner_type_name == "__VOID"
+    ));
+    assert!(matches!(
+        index.find_effective_type_info("ANY_BIT"),
+        Some(DataTypeInformation::Pointer { inner_type_name, .. }) if inner_type_name == "__VOID"
+    ));
+    assert!(matches!(
+        index.find_effective_type_info("ANY_DUT"),
+        Some(DataTypeInformation::Pointer { inner_type_name, .. }) if inner_type_name == "__VOID"
+    ));
+}
