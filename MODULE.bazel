module(
    name = "rules_plc",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.0.16")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_python", version = "2.2.0")

_PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
]

_DEFAULT_PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

[
    python.toolchain(
        is_default = python_version == _DEFAULT_PYTHON_VERSION,
        python_version = python_version,
    )
    for python_version in _PYTHON_VERSIONS
]

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# tc3tools' STFormatter.format() doesn't end its output with a newline (see
# tools/fmt_st.py) -- patched here rather than worked around in our own
# wrapper since it's a property of the formatted file content itself.
pip.override(
    file = "tc3tools-0.1.2-py3-none-any.whl",
    patch_strip = 1,
    patches = ["//third_party/tc3tools:add-trailing-newline.patch"],
)

[
    pip.parse(
        hub_name = "rules_plc_pip_deps",
        python_version = python_version,
        requirements_lock = "//:requirements_lock.txt",
    )
    for python_version in _PYTHON_VERSIONS
]

use_repo(pip, "rules_plc_pip_deps")
