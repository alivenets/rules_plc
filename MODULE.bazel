module(
    name = "rules_plc",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.0.16")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "toolchains_llvm", version = "1.8.0")
bazel_dep(name = "googletest", version = "1.15.2")

single_version_override(
    module_name = "toolchains_llvm",
    patches = [
        "//third_party/toolchains_llvm:cc_library_clang_headers.patch",
        "//third_party/toolchains_llvm:llvm_static_libs.patch",
    ],
    patch_strip = 1,
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "21.1.8",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains(
    "@llvm_toolchain//:all",
)

bazel_dep(name = "rules_rust", version = "0.71.3")

# crate.annotation's override_target_build_script/override_target_proc_macro
# write to the wrong override_targets dict keys ("proc_macro"/"build_script"
# instead of the "proc-macro"/"custom-build" crates_repository actually reads)
# as of 0.71.3 -- needed for the llvm-sys build-script override below to take
# effect at all.
single_version_override(
    module_name = "rules_rust",
    patches = ["//third_party/rules_rust:allow-custom-build-script.patch"],
    patch_strip = 1,
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Transitive shared libs inkwell/llvm-sys links against; crate_universe doesn't
# resolve these on its own (see third_party/rusty/BUILD.bazel).
bazel_dep(name = "libffi", version = "3.4.7.bcr.4")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
bazel_dep(name = "libxml2", version = "2.15.3")
bazel_dep(name = "zlib", version = "1.3.2")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rusty",
    url = "https://github.com/PLC-lang/rusty/archive/13500a827ba5ddb968225420aa9bb48a89547194.zip",
    integrity = "sha256-unbRPnSDKkIEbc4zvOK/Q3J1IKQU3Iy6f0rqgpECAgQ=",
    strip_prefix = "rusty-13500a827ba5ddb968225420aa9bb48a89547194",
    build_file = "//third_party/rusty:rusty.BUILD.bazel",
    patch_args = ["-p1"],
    patches = [
        "//third_party/rusty:support-generic-data-types.patch",
        "//third_party/rusty:handle-VAR_EXTERNAL.patch",
        "//third_party/rusty:more_any_natures.patch",
        "//third_party/rusty:any_header_void_pointer.patch",
    ],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "llvm-sys",
    version = "211.0.1",
    repositories = ["rusty_crates"],
    gen_build_script = "on",
    build_script_data = [
        "//third_party/llvm-sys:llvm_prefix",
    ],
    build_script_compile_data = ["//third_party/llvm-sys:llvm_sys_build_script"],
    build_script_rundir = "",
    override_target_build_script = "//third_party/llvm-sys:llvm_sys_build_script",
    # llvm-sys's rustc-link-search points at the LLVM toolchain's lib/ dir
    # (see //third_party/llvm-sys:build.rs); without these declared as a real
    # data dependency, the archives aren't hermetically materialized for the
    # linking action, and the build only worked by the rustc action escaping
    # the sandbox to read the (user/machine-specific) Bazel output base path.
    data = ["@llvm_toolchain_llvm//:lib_archives"],
    # wrappers/target.c is compiled as an ordinary cc_library (see
    # //third_party/llvm-sys:BUILD.bazel) rather than by build.rs itself.
    # Unlike override_target_build_script (a real attr.label, resolved
    # relative to this module), link_deps is a plain string spliced into the
    # generated BUILD file inside the llvm-sys crate's own repo, so it needs
    # an explicit main-repo anchor -- a bare "//third_party/llvm-sys:..."
    # would resolve relative to that repo instead of this one.
    link_deps = ["@@//third_party/llvm-sys:targetwrappers"],
    label_injections = {
        "@llvm_toolchain_llvm": "@llvm_toolchain_llvm",
    },
)
crate.from_cargo(
    name = "rusty_crates",
    cargo_lockfile = "@rusty//:Cargo.lock",
    manifests = ["@rusty//:Cargo.toml"],
    generate_build_scripts = True,
)
use_repo(crate, "rusty_crates", "rusty_crates__llvm-sys-211.0.1")

register_toolchains(
    "//third_party/rusty:plc",
)
